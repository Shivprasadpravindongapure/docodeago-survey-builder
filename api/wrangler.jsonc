{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docodeago-survey-builder-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "survey-builder-db",
      "database_id": "REPLACE_WITH_REAL_D1_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "REPLACE_WITH_REAL_KV_ID",
      "preview_id": "REPLACE_WITH_REAL_KV_PREVIEW_ID"
    }
  ],
  "dev": {
    "port": 8787
  }
}
