{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Root-level config used by the Cloudflare Workers Builds CI.
  // The CI runs `npx wrangler deploy` from the repo root with wrangler 4.
  //
  // Wrangler 4 refuses workspace-root deploys, so we add "pages_build_output_dir"
  // to tell it this is a Pages project and deploy the static frontend.
  // The API Worker is deployed via api/wrangler.jsonc separately.
  "name": "docodeago-survey-builder",
  "pages_build_output_dir": "web/dist",
  "compatibility_date": "2024-07-25"
}
